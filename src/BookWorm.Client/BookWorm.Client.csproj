<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- WebAssembly entry point for the web app: registers the browser-specific services
       (cookie session, same-origin HttpClient) and boots the shared UI. -->

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookWorm.Contracts\BookWorm.Contracts.csproj" />
    <ProjectReference Include="..\BookWorm.UI\BookWorm.UI.csproj" />
  </ItemGroup>

</Project>
