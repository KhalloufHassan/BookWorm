<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Android app: .NET MAUI Blazor Hybrid, showing the pages of BookWorm.UI in a native web view.
       Building it needs the maui-android workload, so it isn't in BookWorm.slnx or the Docker image;
       see "Android app" in the README. -->

  <PropertyGroup>
    <!-- Replaces Directory.Build.props' net10.0. For iOS later: TargetFrameworks with net10.0-ios too. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookWorm.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>BookWorm</ApplicationTitle>
    <ApplicationId>org.khallouflabs.bookworm</ApplicationId>
    <!-- Release builds set both from the android-vX.Y.Z tag and the build number (.github/workflows/android-release.yml).
         ApplicationVersion must always go up, or Android refuses to install the update. -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- An APK can be installed directly (from GitHub releases); Google Play would want an AAB instead. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Android 7.0: the oldest the Blazor web view supports. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- The Android build reports platform warnings of its own; the C# code itself stays warning-free. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\bookworm.png" ForegroundScale="0.62" Color="#FBF3E6" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F7F1E6" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookWorm.Contracts\BookWorm.Contracts.csproj" />
    <ProjectReference Include="..\BookWorm.UI\BookWorm.UI.csproj" />
    <ProjectReference Include="..\BookWorm.Mobile.Core\BookWorm.Mobile.Core.csproj" />
  </ItemGroup>

  <Import Project="ReaderLibraries.targets" />

  <!-- The logo and the boot-screen styles are the web app's, copied in (git ignores the copies). -->
  <Target Name="CopySharedWebFiles" AfterTargets="Restore" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\BookWorm.Server\wwwroot\bookworm-icon.png;..\BookWorm.Server\wwwroot\favicon.png" DestinationFolder="wwwroot" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\BookWorm.Server\wwwroot\app.css" DestinationFolder="wwwroot\shared" SkipUnchangedFiles="true" />
  </Target>

</Project>
