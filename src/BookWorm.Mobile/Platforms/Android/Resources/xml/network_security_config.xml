<?xml version="1.0" encoding="utf-8"?>
<!-- Never plain HTTP, and only certificates the system trusts (e.g. Let's Encrypt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
