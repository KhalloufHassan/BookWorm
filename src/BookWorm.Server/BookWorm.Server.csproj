<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The SDK only downloads blazor.web.js when it sees .razor files during restore. The Dockerfile
         restores from the project files alone (for layer caching), so declare the need explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookWorm.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookWorm.Client\BookWorm.Client.csproj" />
    <ProjectReference Include="..\BookWorm.Contracts\BookWorm.Contracts.csproj" />
    <ProjectReference Include="..\BookWorm.UI\BookWorm.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
