@inject IOfflineLibrary Offline

<MudNavMenu Class="bw-nav" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">Home</MudNavLink>
    <MudNavLink Href="books" Icon="@Icons.Material.Rounded.AutoStories">Books</MudNavLink>
    <MudNavLink Href="authors" Icon="@Icons.Material.Rounded.HistoryEdu">Authors</MudNavLink>
    <MudNavLink Href="tags" Icon="@Icons.Material.Rounded.Sell">Tags</MudNavLink>
    <MudNavLink Href="calendar" Icon="@Icons.Material.Rounded.CalendarMonth">Calendar</MudNavLink>
    @if (Offline.IsSupported)
    {
        <MudNavLink Href="downloads" Icon="@Icons.Material.Rounded.DownloadForOffline">Downloaded</MudNavLink>
    }
    <AuthorizeView Roles="@RoleNames.Admin">
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.overline" Class="px-4 bw-nav-heading">Administration</MudText>
        <MudNavLink Href="admin/users" Icon="@Icons.Material.Rounded.ManageAccounts">Users</MudNavLink>
        <MudNavLink Href="admin/backups" Icon="@Icons.Material.Rounded.Backup">Backups</MudNavLink>
    </AuthorizeView>
    <MudDivider Class="my-3" />
    <MudNavLink Href="about" Icon="@Icons.Material.Rounded.Info">About</MudNavLink>
</MudNavMenu>
