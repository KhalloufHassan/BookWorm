@page "/books/new"
@page "/books/{Id:guid}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@inject BookWormApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject BrowserFiles Files
@inject PendingBook Pending

<PageTitle>@(IsNew ? "Add a book" : "Edit book") · BookWorm</PageTitle>

<MudButton Href="@BackHref" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" Class="mb-4">@(IsNew ? "Books" : "Back to the book")</MudButton>

<PageHeader Title="@(IsNew ? "Add a book" : "Edit book")" />

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else if (_form is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ServerValidation @ref="_serverValidation" />
        <MudPaper Elevation="0" Class="bw-form">
            @if (_pending is { } pending)
            {
                <div class="bw-from-file">
                    @if (pending.CoverPreviewUrl is not null)
                    {
                        <BookCover Id="Guid.Empty" Title="@_form.Title" PreviewUrl="@(_useCover ? pending.CoverPreviewUrl : null)" Size="small" />
                    }
                    <div class="bw-from-file__text">
                        <MudText Typo="Typo.subtitle1"><MudIcon Icon="@Icons.Material.Rounded.AttachFile" Size="Size.Small" /> @pending.File.Name</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @BookFormats.Label(pending.Format) · @FileSizes.Describe(pending.File.Size). The details below come from the file; check them, then add the book. The file uploads right after.
                        </MudText>
                        @if (pending.Metadata.CoverKey is not null)
                        {
                            <MudCheckBox T="bool" @bind-Value="_useCover" Color="Color.Primary" Dense="true" Label="Use the cover from the file" />
                        }
                        @if (_uploadProgress is { } progress)
                        {
                            <MudProgressLinear Value="@(progress * 100)" Color="Color.Primary" Rounded="true" Class="mt-2" />
                            <MudText Typo="Typo.caption">Uploading… @Labels.Percent(progress)</MudText>
                        }
                    </div>
                </div>
            }
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField Label="Title" @bind-Value="_form.Title" For="@(() => _form.Title)" Variant="Variant.Outlined" AutoFocus="IsNew" />
                </MudItem>
                <MudItem xs="12">
                    <AuthorPicker @bind-Value="_form.Authors" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="BookStatus" Label="Status" @bind-Value="_form.Status" Variant="Variant.Outlined">
                        @foreach (var status in Labels.BookStatuses)
                        {
                            <MudSelectItem Value="status">@Labels.For(status)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="bw-rating-field">
                        <MudNumericField T="decimal?" Label="Rating (0–5)" @bind-Value="_form.Rating" For="@(() => _form.Rating)"
                                         Min="0" Max="5" Step="0.1m" Clearable="true" Variant="Variant.Outlined"
                                         HelperText="One decimal, for example 4.8" />
                        <RatingStars Value="_form.Rating" ShowNumber="false" Large="true" />
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="First published" @bind-Date="_form.OriginalPublicationDate" Editable="true" Clearable="true"
                                   DateFormat="d MMM yyyy" Variant="Variant.Outlined" OpenTo="OpenTo.Year"
                                   HelperText="@PublishedHint" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <TagPicker @bind-Value="_form.Tags" />
                </MudItem>
                <MudItem xs="12">
                    <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" Class="bw-notes-tabs">
                        <MudTabPanel Text="Notes" Icon="@Icons.Material.Rounded.EditNote">
                            <MudTextField T="string" @bind-Value="_form.Notes" For="@(() => _form.Notes)" Lines="12" Variant="Variant.Outlined"
                                          Placeholder="Your thoughts about the book. Markdown works: **bold**, *italic*, # headings, - lists, [links](https://…)" />
                        </MudTabPanel>
                        <MudTabPanel Text="Preview" Icon="@Icons.Material.Rounded.Visibility">
                            <MarkdownView Markdown="@_form.Notes">
                                <Empty><MudText Color="Color.Secondary">Nothing to preview yet.</MudText></Empty>
                            </MarkdownView>
                        </MudTabPanel>
                    </MudTabs>
                </MudItem>
            </MudGrid>

            @if (_serverValidation?.GeneralErrors.Count > 0 || _error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">
                    @(_error ?? string.Join(" ", _serverValidation.GeneralErrors))
                </MudAlert>
            }

            <div class="bw-form__actions">
                <MudButton Href="@BackHref" Variant="Variant.Text">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                           StartIcon="@Icons.Material.Rounded.Check">@(IsNew ? "Add book" : "Save changes")</MudButton>
            </div>
        </MudPaper>
    </EditForm>
}

@code {
    private BookForm _form;
    private uint? _version;
    private ServerValidation _serverValidation;
    private string _loadError;
    private string _error;
    private bool _saving;

    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Pre-selects an author when adding a book from an author's page.</summary>
    [SupplyParameterFromQuery]
    public Guid? AuthorId { get; set; }

    /// <summary>Set when coming from "Add from file": the form is pre-filled from the picked file.</summary>
    [SupplyParameterFromQuery]
    public bool FromFile { get; set; }

    private PendingBookFile _pending;
    private bool _useCover = true;
    private double? _uploadProgress;

    private bool IsNew => Id is null;
    private string BackHref => IsNew ? "books" : $"books/{Id}";

    /// <summary>When the file only gives a year, show it, since the field needs a full date.</summary>
    private string PublishedHint => _pending?.Metadata switch
    {
        { Published: not null } => "From the file. Ebooks often give the date of their edition, not the first publication.",
        { PublishedText: { Length: > 0 } text } => $"The file says: {text}",
        _ => null,
    };

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (Id is { } id)
            {
                var book = await Api.GetBookAsync(id);
                _version = book.Version;
                _form = new BookForm
                {
                    Title = book.Title,
                    Status = book.Status,
                    Rating = book.Rating,
                    Notes = book.Notes,
                    OriginalPublicationDate = book.OriginalPublicationDate?.ToDateTime(TimeOnly.MinValue),
                    Authors = book.Authors.ToList(),
                    Tags = book.Tags.ToList(),
                };
            }
            else
            {
                _form = new BookForm();
                if (AuthorId is { } authorId)
                {
                    var author = await Api.GetAuthorAsync(authorId);
                    _form.Authors.Add(new AuthorRef(author.Id, author.Name));
                }

                if (FromFile && Pending.Current is { } pending)
                {
                    Pending.Current = null;
                    _pending = pending;
                    await FillFromFileAsync(pending.Metadata);
                }
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _loadError = ApiErrorMessages.Describe(ex);
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            BookDetails saved;
            if (Id is { } id)
            {
                var update = new UpdateBookRequest { Version = _version };
                Fill(update, _form);
                saved = await Api.UpdateBookAsync(id, update);
            }
            else
            {
                await CreateNewAuthorsAsync();
                var create = new CreateBookRequest();
                Fill(create, _form);
                saved = await Api.CreateBookAsync(create);
            }

            Snackbar.Add(IsNew ? $"Added “{saved.Title}” to your library." : "Saved.", Severity.Success);
            if (_pending is not null)
            {
                await UploadPendingAsync(saved.Id);
            }

            Navigation.NavigateTo($"books/{saved.Id}");
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest && ex.Errors.Count > 0)
        {
            _serverValidation?.Show(ex.Errors);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ApiErrorMessages.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Title, date and authors from the file. Authors are matched to existing ones by name; the rest are created on save.</summary>
    private async Task FillFromFileAsync(FileMetadata metadata)
    {
        _form.Title = metadata.Title.Length > ApiLimits.TitleMaxLength ? metadata.Title[..ApiLimits.TitleMaxLength] : metadata.Title;
        if (DateOnly.TryParseExact(metadata.Published, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var published))
        {
            _form.OriginalPublicationDate = published.ToDateTime(TimeOnly.MinValue);
        }

        foreach (var name in metadata.Authors.Take(ApiLimits.MaxAuthorsPerBook))
        {
            var found = await Api.GetAuthorsAsync(new AuthorListQuery { Search = name, PageSize = 10 });
            var existing = found.Items.FirstOrDefault(a => string.Equals(a.Name, name, StringComparison.OrdinalIgnoreCase));
            var author = existing is null ? new AuthorRef(Guid.Empty, name) : new AuthorRef(existing.Id, existing.Name);
            if (_form.Authors.All(a => a.Id == Guid.Empty ? a.Name != author.Name : a.Id != author.Id))
            {
                _form.Authors.Add(author);
            }
        }
    }

    private async Task CreateNewAuthorsAsync()
    {
        for (var i = 0; i < _form.Authors.Count; i++)
        {
            if (_form.Authors[i].Id == Guid.Empty)
            {
                var name = _form.Authors[i].Name;
                var created = await Api.CreateAuthorAsync(new CreateAuthorRequest
                {
                    Name = name.Length > ApiLimits.AuthorNameMaxLength ? name[..ApiLimits.AuthorNameMaxLength] : name,
                });
                _form.Authors[i] = new AuthorRef(created.Id, created.Name);
            }
        }
    }

    /// <summary>Uploads the picked file (and its cover) to the book that was just added.</summary>
    private async Task UploadPendingAsync(Guid bookId)
    {
        var pending = _pending;
        try
        {
            _uploadProgress = 0;
            StateHasChanged();
            await Files.UploadAsync<BookFileDetails>(pending.File.Key, BookWormApiClient.FileUploadUrl(bookId, pending.Format, pending.File.Name), (loaded, total) =>
            {
                _uploadProgress = total > 0 ? (double)loaded / total : 0;
                InvokeAsync(StateHasChanged);
            });
            if (_useCover && pending.Metadata.CoverKey is { } cover)
            {
                await Files.UploadAsync<CoverDetails>(cover, BookWormApiClient.CoverUploadUrl(bookId));
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or Microsoft.JSInterop.JSException)
        {
            var reason = ex is Microsoft.JSInterop.JSException js ? js.Message.Split('\n')[0] : ApiErrorMessages.Describe(ex);
            Snackbar.Add($"The book was added, but its file couldn't be uploaded: {reason} Upload it again on the book's page.", Severity.Error);
        }
        finally
        {
            _uploadProgress = null;
            await ReleasePendingAsync();
        }
    }

    private async Task ReleasePendingAsync()
    {
        if (_pending is { } pending)
        {
            _pending = null;
            await Files.ReleaseAsync(pending.File.Key);
            await Files.ReleaseAsync(pending.Metadata.CoverKey);
        }
    }

    public async ValueTask DisposeAsync() => await ReleasePendingAsync();

    private static void Fill(CreateBookRequest request, BookForm form)
    {
        request.Title = form.Title.Trim();
        request.Status = form.Status;
        request.Rating = form.Rating;
        request.Notes = string.IsNullOrWhiteSpace(form.Notes) ? null : form.Notes;
        request.OriginalPublicationDate = form.OriginalPublicationDate is { } date ? DateOnly.FromDateTime(date) : null;
        request.AuthorIds = form.Authors.Select(a => a.Id).ToList();
        request.TagIds = form.Tags.Select(t => t.Id).ToList();
    }

    private sealed class BookForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Give the book a title.")]
        [System.ComponentModel.DataAnnotations.StringLength(ApiLimits.TitleMaxLength)]
        public string Title { get; set; } = "";

        public BookStatus Status { get; set; } = BookStatus.WantToRead;

        [Rating]
        public decimal? Rating { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(ApiLimits.NotesMaxLength)]
        public string Notes { get; set; }

        public DateTime? OriginalPublicationDate { get; set; }

        public List<AuthorRef> Authors { get; set; } = [];

        public List<TagRef> Tags { get; set; } = [];
    }
}
