@inject BookWormApiClient Api

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            Set a new password for <strong>@User.UserName</strong>. This also unlocks the account and signs them out of their other sessions.
        </MudText>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="password-form">
            <DataAnnotationsValidator />
            <ServerValidation @ref="_serverValidation" />
            <div class="bw-dialog-fields">
                <MudTextField Label="New password" @bind-Value="_form.NewPassword" For="@(() => _form.NewPassword)" InputType="InputType.Password"
                              Variant="Variant.Outlined" autocomplete="new-password" AutoFocus="true" />
                <MudTextField Label="Repeat the new password" @bind-Value="_form.Confirm" For="@(() => _form.Confirm)" InputType="InputType.Password"
                              Variant="Variant.Outlined" autocomplete="new-password" />
            </div>
        </EditForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="password-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Set password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly PasswordForm _form = new();
    private ServerValidation _serverValidation;
    private string _error;
    private bool _saving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter, EditorRequired]
    public AdminUser User { get; set; }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await Api.ResetPasswordAsync(User.Id, new ResetPasswordRequest { NewPassword = _form.NewPassword });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest && ex.Errors.Count > 0)
        {
            _serverValidation?.Show(ex.Errors.ToDictionary(e => e.Key == "password" ? "newPassword" : e.Key, e => e.Value));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ApiErrorMessages.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class PasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a new password.")]
        [System.ComponentModel.DataAnnotations.StringLength(ApiLimits.PasswordMaxLength, MinimumLength = ApiLimits.PasswordMinLength,
            ErrorMessage = "The password must be at least {2} characters long.")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "The passwords don't match.")]
        public string Confirm { get; set; } = "";
    }
}
