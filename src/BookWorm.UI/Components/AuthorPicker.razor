@* Pick a book's authors in display order; unknown names can be added as new authors on the spot. *@
@inject BookWormApiClient Api
@inject ISnackbar Snackbar

<div class="bw-picker">
    <MudAutocomplete @ref="_search" T="PickOption" Label="Authors" Placeholder="Type a name to add an author"
                     SearchFunc="SearchAsync" ToStringFunc="@(option => option?.Name ?? "")" ValueChanged="AddAsync"
                     DebounceInterval="250" MinCharacters="1" CoerceText="false" ResetValueOnEmptyText="true"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                     Error="@(Error is not null)" ErrorText="@Error" AdornmentIcon="@Icons.Material.Rounded.PersonAdd">
        <ItemTemplate Context="option">
            @if (option.IsNew)
            {
                <MudText><MudIcon Icon="@Icons.Material.Rounded.Add" Size="Size.Small" Class="mr-2" />Add “@option.Name” as a new author</MudText>
            }
            else
            {
                <MudText>@option.Name</MudText>
            }
        </ItemTemplate>
    </MudAutocomplete>

    @if (Value.Count > 0)
    {
        <ol class="bw-picker__list">
            @for (var i = 0; i < Value.Count; i++)
            {
                var index = i;
                var author = Value[index];
                <li>
                    <span class="bw-picker__name">
                        @author.Name
                        @if (author.Id == Guid.Empty)
                        {
                            <span class="bw-new-badge" title="Added to your authors when you save">new</span>
                        }
                    </span>
                    <MudIconButton Icon="@Icons.Material.Rounded.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)"
                                   OnClick="@(() => MoveUpAsync(index))" aria-label="@($"Move {author.Name} up")" />
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                   OnClick="@(() => RemoveAsync(index))" aria-label="@($"Remove {author.Name}")" />
                </li>
            }
        </ol>
    }
</div>

@code {
    private MudAutocomplete<PickOption> _search;

    [Parameter]
    public List<AuthorRef> Value { get; set; } = [];

    [Parameter]
    public EventCallback<List<AuthorRef>> ValueChanged { get; set; }

    [Parameter]
    public string Error { get; set; }

    private async Task<IEnumerable<PickOption>> SearchAsync(string text, CancellationToken cancellationToken)
    {
        var name = text?.Trim() ?? "";
        if (name.Length == 0)
        {
            return [];
        }

        var found = await Api.GetAuthorsAsync(new AuthorListQuery { Search = name, PageSize = 8 }, cancellationToken);
        var options = found.Items
            .Where(a => Value.All(chosen => chosen.Id != a.Id))
            .Select(a => new PickOption(a.Id, a.Name))
            .ToList();

        if (!found.Items.Any(a => string.Equals(a.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            options.Add(new PickOption(null, name));
        }

        return options;
    }

    private async Task AddAsync(PickOption option)
    {
        if (option is null)
        {
            return;
        }

        try
        {
            var author = option.Id is { } id
                ? new AuthorRef(id, option.Name)
                : await CreateAsync(option.Name);
            if (Value.All(a => a.Id != author.Id))
            {
                await ValueChanged.InvokeAsync([.. Value, author]);
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Snackbar.Add(ApiErrorMessages.Describe(ex), Severity.Error);
        }

        if (_search is not null)
        {
            await _search.ClearAsync();
        }
    }

    private async Task<AuthorRef> CreateAsync(string name)
    {
        var created = await Api.CreateAuthorAsync(new CreateAuthorRequest { Name = name });
        Snackbar.Add($"Added {created.Name} to your authors.", Severity.Success);
        return new AuthorRef(created.Id, created.Name);
    }

    private Task MoveUpAsync(int index)
    {
        var reordered = Value.ToList();
        (reordered[index - 1], reordered[index]) = (reordered[index], reordered[index - 1]);
        return ValueChanged.InvokeAsync(reordered);
    }

    private Task RemoveAsync(int index)
    {
        var remaining = Value.ToList();
        remaining.RemoveAt(index);
        return ValueChanged.InvokeAsync(remaining);
    }
}
