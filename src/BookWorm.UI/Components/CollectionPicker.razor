@* Pick the collections a book is in. Collections are created on the Collections page, where their type is chosen. *@
@inject BookWormApiClient Api

<div class="bw-picker">
    <MudAutocomplete @ref="_search" T="CollectionSummary" Label="Collections" Placeholder="Type to add to a collection"
                     SearchFunc="SearchAsync" ToStringFunc="@(collection => collection?.Name ?? "")" ValueChanged="AddAsync"
                     DebounceInterval="150" MinCharacters="0" CoerceText="false" ResetValueOnEmptyText="true"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
                     AdornmentIcon="@Icons.Material.Rounded.CollectionsBookmark">
        <ItemTemplate Context="collection">
            <MudText><MudIcon Icon="@Labels.IconFor(collection.Type)" Size="Size.Small" Class="mr-2" />@collection.Name</MudText>
        </ItemTemplate>
        <NoItemsTemplate>
            <MudText Class="pa-2" Color="Color.Secondary">No matching collections. Create one on the Collections page.</MudText>
        </NoItemsTemplate>
    </MudAutocomplete>

    @if (Value.Count > 0)
    {
        <div class="bw-picker__chips">
            @foreach (var collection in Value)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Icon="@Labels.IconFor(collection.Type)"
                         OnClose="@(() => RemoveAsync(collection))">@collection.Name</MudChip>
            }
        </div>
    }
</div>

@code {
    private MudAutocomplete<CollectionSummary> _search;
    private List<CollectionSummary> _allCollections;

    [Parameter]
    public List<CollectionRef> Value { get; set; } = [];

    [Parameter]
    public EventCallback<List<CollectionRef>> ValueChanged { get; set; }

    private async Task<IEnumerable<CollectionSummary>> SearchAsync(string text, CancellationToken cancellationToken)
    {
        _allCollections ??= await Api.GetCollectionsAsync(cancellationToken: cancellationToken);
        var name = text?.Trim() ?? "";

        return _allCollections
            .Where(c => Value.All(chosen => chosen.Id != c.Id))
            .Where(c => name.Length == 0 || c.Name.Contains(name, StringComparison.CurrentCultureIgnoreCase))
            .Take(12)
            .ToList();
    }

    private async Task AddAsync(CollectionSummary collection)
    {
        if (collection is null)
        {
            return;
        }

        if (Value.All(c => c.Id != collection.Id))
        {
            await ValueChanged.InvokeAsync([.. Value, new CollectionRef(collection.Id, collection.Name, collection.Type)]);
        }

        if (_search is not null)
        {
            await _search.ClearAsync();
        }
    }

    private Task RemoveAsync(CollectionRef collection) => ValueChanged.InvokeAsync(Value.Where(c => c.Id != collection.Id).ToList());
}
