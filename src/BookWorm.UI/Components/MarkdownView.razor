@if (string.IsNullOrWhiteSpace(Markdown))
{
    @Empty
}
else
{
    <div class="bw-markdown @Class">@((MarkupString)_html)</div>
}

@code {
    private string _rendered;
    private string _html = "";

    [Parameter]
    public string Markdown { get; set; }

    /// <summary>Shown when there is nothing to render.</summary>
    [Parameter]
    public RenderFragment Empty { get; set; }

    [Parameter]
    public string Class { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Markdown) && Markdown != _rendered)
        {
            _html = MarkdownRenderer.ToHtml(Markdown);
            _rendered = Markdown;
        }
    }
}
