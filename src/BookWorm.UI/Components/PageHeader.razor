<div class="bw-page-header">
    <div class="bw-page-header__text">
        <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        }
    </div>
    <div class="bw-page-header__actions">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string Subtitle { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }
}
